{
  "name": "fastlock-sdk",
  "version": "0.1.0",
  "description": "The core of FastLock: browser-to-browser encrypted file transfer and calls over WebRTC. No dependencies, no server.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    },
    "./transfer": {
      "types": "./dist/transfer.d.ts",
      "import": "./dist/transfer.js"
    },
    "./call": {
      "types": "./dist/call.d.ts",
      "import": "./dist/call.js"
    },
    "./ice": {
      "types": "./dist/ice.d.ts",
      "import": "./dist/ice.js"
    },
    "./handshake": {
      "types": "./dist/handshake.d.ts",
      "import": "./dist/handshake.js"
    },
    "./idb": {
      "types": "./dist/idb.d.ts",
      "import": "./dist/idb.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json"
  },
  "keywords": [
    "webrtc",
    "p2p",
    "file-transfer",
    "end-to-end-encryption",
    "datachannel",
    "ecdh",
    "aes-gcm",
    "fastlock"
  ],
  "homepage": "https://fastlock.pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimazaytsev82-crypto/fastlock-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/dimazaytsev82-crypto/fastlock-sdk/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
